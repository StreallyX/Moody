# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key

# ===========================================
# CONFIGURATION DEEP LINK (pour confirmation email)
# ===========================================
# Dans Supabase Dashboard :
# 1. Va dans Auth > URL Configuration
# 2. Site URL: moody://
# 3. Redirect URLs: ajoute moody://auth/callback
#
# (Optionnel) Pour personnaliser l'email :
# - Va dans Auth > Email Templates > Confirm signup
# - Copie le template depuis docs/email-template.html

# ===========================================
# APP CONFIGURATION
# ===========================================
APP_ENV=development
